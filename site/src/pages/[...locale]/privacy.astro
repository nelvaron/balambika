---
import Base from '../../layouts/Base.astro';
import { type Locale, getStaticLocalePaths, useTranslations } from '../../i18n/ui';

export const getStaticPaths = getStaticLocalePaths;
const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
const bg = locale === 'bg';
---
<Base
  locale={locale}
  page="privacy/"
  title={t('privacy.title')}
  description={t('privacy.description')}
  crumbs={[{ name: 'Balambika', page: '' }, { name: t('privacy.title'), page: 'privacy/' }]}
>
  <article class="container doc">
    <header class="nv-margin">
      <p class="eyebrow">{bg ? 'Последна промяна: 16 октомври 2026' : 'Last updated: 16 October 2026'}</p>
      <h1>{t('privacy.title')}</h1>
      <p class="lede">{t('privacy.description')}</p>
    </header>
    {bg ? (
      <div class="prose">
        <h2>Какво събираме</h2>
        <p>Нищо. Сайтът е статичен, без бисквитки, без статистика, без вградени услуги на трети страни. Шрифтовете и всички файлове се зареждат от същия адрес.</p>
        <h2>Какво остава в браузъра ви</h2>
        <p>Ако изберете светла или тъмна тема, изборът се пази в localStorage на вашия браузър под ключа <code>theme</code>, за да остане при следващото посещение. Той не се изпраща никъде. Изберете „Авто“, за да го изтриете. Текстът, който пишете в полето за изпробване, не се запазва и не се изпраща.</p>
        <h2>Хостинг</h2>
        <p>Сайтът се хоства от GitHub Pages. Както всеки уеб сървър, GitHub получава IP адреса ви и основни данни за заявката, за да достави страниците и да ги защити от злоупотреби. Как ги обработва, е описано в <a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement" rel="external">декларацията за поверителност на GitHub</a>.</p>
        <h2>Връзка</h2>
        <p>Въпроси можете да зададете като <a href="https://github.com/nelvaron/balambika/issues" rel="external">issue в хранилището</a>.</p>
      </div>
    ) : (
      <div class="prose">
        <h2>What we collect</h2>
        <p>Nothing. The site is static: no cookies, no analytics, no embedded third-party services. Fonts and every other file load from the same address.</p>
        <h2>What stays in your browser</h2>
        <p>If you choose the light or dark theme, the choice is kept in your browser’s localStorage under the key <code>theme</code> so it survives the next visit. It is never sent anywhere. Choose “Auto” to remove it. Text you type in the type tester is neither stored nor sent.</p>
        <h2>Hosting</h2>
        <p>The site is hosted on GitHub Pages. Like any web server, GitHub receives your IP address and basic request data in order to deliver the pages and protect them from abuse. How GitHub handles it is described in the <a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement" rel="external">GitHub General Privacy Statement</a>.</p>
        <h2>Contact</h2>
        <p>Ask questions by opening an <a href="https://github.com/nelvaron/balambika/issues" rel="external">issue in the repository</a>.</p>
      </div>
    )}
  </article>
</Base>

<style>
  .doc { display: grid; gap: var(--space-48); padding-block: clamp(var(--space-48), 8vw, var(--space-88)); max-width: calc(var(--measure-text) + 2 * var(--gutter)); }
  header { display: grid; gap: var(--space-16); }
  h1 { font: var(--type-display); letter-spacing: -0.02em; }
  .prose { display: grid; gap: var(--space-16); }
  .prose h2 { font: var(--type-heading-2); margin-top: var(--space-24); }
  .prose code { background: var(--band); padding: 0.1em 0.35em; border-radius: var(--radius-sm); }
</style>
