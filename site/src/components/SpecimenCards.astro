---
import glyphs from '../data/generated/glyphs.json';
import glyphsSans from '../data/generated/glyphs-sans.json';
import { type Locale, localePath, useTranslations, formatNumber } from '../i18n/ui';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
type ScriptKey = keyof typeof glyphs.groups;
const count = (data: typeof glyphs, s: ScriptKey) => data.groups[s].reduce((n, g) => n + g.cps.length, 0);
const counts = (s: ScriptKey) => ({ serif: count(glyphs, s), sans: count(glyphsSans as typeof glyphs, s) });
const cards = [
  { id: 'devanagari', name: t('nav.devanagari'), sample: 'क्ष्म्य', lang: 'sa', cls: 'deva', n: counts('devanagari') },
  { id: 'latin', name: t('nav.latin'), sample: 'Ṛṣ', lang: 'sa-Latn', cls: 'latn', n: counts('latin') },
  { id: 'cyrillic', name: t('nav.cyrillic'), sample: 'Жд', lang: 'bg', cls: 'cyrl', n: counts('cyrillic') },
];
---
<section class="section section--band" aria-labelledby="spec-title">
  <div class="container">
    <header class="section-head reveal">
      <p class="eyebrow">{t('spec.eyebrow')}</p>
      <h2 id="spec-title">{t('spec.title')}</h2>
      <p>{t('spec.lede')}</p>
    </header>
    <ul class="cards" role="list">
      {cards.map((c) => (
        <li class="reveal">
          <a class={`spec card spec--${c.cls}`} href={localePath(locale, `specimens/${c.id}/`)}>
            <span class="sample" lang={c.lang} aria-hidden="true">{c.sample}</span>
            <span class="name">{c.name}</span>
            <span class="count only-serif">{t('specimen.count', { n: formatNumber(locale, c.n.serif) })}</span>
            <span class="count only-sans">{t('specimen.count', { n: formatNumber(locale, c.n.sans) })}</span>
            <span class="visually-hidden">— {t('spec.open', { name: c.name })}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); gap: var(--space-24); margin: 0; }
  .spec {
    display: grid;
    gap: var(--space-8);
    padding: var(--space-32);
    color: var(--ink);
    text-decoration: none;
    min-height: 100%;
    transition: border-color 160ms, translate 160ms;
  }
  .spec:hover { color: var(--ink); border-color: var(--control-border); translate: 0 -2px; }
  @media (prefers-reduced-motion: reduce) { .spec { transition: none; } .spec:hover { translate: none; } }
  .sample { font: 400 clamp(4rem, 3rem + 4vw, 6.5rem) / 1.3 var(--font-text); }
  .spec--deva .sample { color: var(--script-deva); }
  .spec--latn .sample { color: var(--script-latn); font-style: italic; }
  .spec--cyrl .sample { color: var(--script-cyrl); }
  .name { font: var(--type-heading-2); }
  .count { font: var(--type-eyebrow); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-2); }
  .name::after { content: ' →'; color: var(--accent); }
</style>
