---
import { type Locale, useTranslations } from '../i18n/ui';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
---
<figure class="globe" data-globe>
  <div class="stage">
    <canvas role="img" aria-label={t('globe.label')}></canvas>
    <div class="still" aria-hidden="true">
      <span lang="sa">क</span><span lang="sa-Latn">k</span><span lang="bg">к</span>
    </div>
    <p class="caption" data-globe-caption aria-hidden="true">
      <span lang="sa">क</span><span lang="sa-Latn">k</span><span lang="bg">к</span>
    </p>
    <button
      class="toggle"
      type="button"
      data-globe-toggle
      aria-pressed="false"
      data-pause={t('globe.pause')}
      data-play={t('globe.play')}
    >
      <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
        <path class="i-pause" d="M5.5 3.5v9M10.5 3.5v9" />
        <path class="i-play" d="M5 3.2v9.6L12.5 8z" />
      </svg>
      <span data-label>{t('globe.pause')}</span>
    </button>
  </div>
  <figcaption class="legend">
    <span class="visually-hidden">{t('globe.legend')}:</span>
    <span class="key key--deva">{t('nav.devanagari')}</span>
    <span class="key key--latn">IAST</span>
    <span class="key key--cyrl">{t('nav.cyrillic')}</span>
  </figcaption>
</figure>

<script>
  import { mountGlobe } from '../scripts/globe';
  for (const el of document.querySelectorAll<HTMLElement>('[data-globe]')) mountGlobe(el);
</script>

<style>
  .globe {
    position: relative;
    display: grid;
    gap: var(--space-16);
    padding: clamp(var(--space-16), 3vw, var(--space-32));
    border-radius: var(--radius-xl);
    background:
      repeating-linear-gradient(to bottom, transparent 0 31px, var(--night-rule) 31px 32px),
      var(--night);
    color: var(--night-ink);
    overflow: hidden;
    isolation: isolate;
  }
  .globe::before {
    content: '';
    position: absolute;
    inset-block: 0;
    inset-inline-start: clamp(var(--space-16), 3vw, var(--space-32));
    width: var(--rule-width);
    background: var(--ochre-warm);
    opacity: 0.8;
  }
  .stage { position: relative; aspect-ratio: 1; width: 100%; max-width: 620px; margin-inline: auto; }
  canvas { width: 100%; height: 100%; touch-action: pan-y; cursor: grab; }
  canvas:active { cursor: grabbing; }

  /* Shown until the script has the fonts and draws the first frame. */
  .still {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    grid-auto-flow: column;
    gap: 0.4em;
    font: 400 clamp(3rem, 10vw, 6rem) / 1 var(--font-text);
    pointer-events: none;
  }
  .still span:nth-child(1) { color: var(--night-deva); }
  .still span:nth-child(2) { color: var(--night-latn); font-style: italic; }
  .still span:nth-child(3) { color: var(--night-cyrl); }
  :global(.is-ready) .still { display: none; }

  .caption {
    position: absolute;
    inset-inline-end: 0;
    inset-block-start: 0;
    display: flex;
    gap: var(--space-12);
    align-items: baseline;
    font: 500 1.5rem / 1.4 var(--font-text);
    opacity: 0;
  }
  :global(.is-ready) .caption { opacity: 1; }
  .caption span:nth-child(1) { color: var(--night-deva); }
  .caption span:nth-child(2) { color: var(--night-latn); font-style: italic; }
  .caption span:nth-child(3) { color: var(--night-cyrl); }
  .caption span + span::before { content: '→'; margin-inline-end: var(--space-12); color: var(--night-ink-2); font-style: normal; font-size: 0.8em; }
  @media (prefers-reduced-motion: no-preference) {
    .caption.is-fresh span { animation: rise 600ms both; }
    .caption.is-fresh span:nth-child(2) { animation-delay: 1.3s; }
    .caption.is-fresh span:nth-child(3) { animation-delay: 2.6s; }
  }
  @keyframes rise { from { opacity: 0; translate: 0 6px; } }

  .toggle {
    position: absolute;
    inset-inline-start: var(--space-12);
    inset-block-end: 0;
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    min-height: 44px;
    padding: 0 var(--space-16);
    border: 1px solid #75827c;
    border-radius: var(--radius-pill);
    background: rgb(14 23 18 / 0.75);
    color: var(--night-ink);
    font: var(--type-caption);
    cursor: pointer;
  }
  .toggle:hover { background: #1f2723; }
  .toggle:focus-visible { outline-color: var(--night-deva); }
  .toggle .i-play { display: none; }
  .toggle[aria-pressed='true'] .i-play { display: inline; }
  .toggle[aria-pressed='true'] .i-pause { display: none; }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8) var(--space-24);
    justify-content: center;
    font: var(--type-eyebrow);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--night-ink-2);
  }
  .key { display: inline-flex; align-items: center; gap: var(--space-8); }
  .key::before { content: ''; width: 10px; height: 10px; border-radius: 50%; }
  .key--deva::before { background: var(--night-deva); }
  .key--latn::before { background: var(--night-latn); }
  .key--cyrl::before { background: var(--night-cyrl); }
</style>
