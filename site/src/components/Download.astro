---
import { type Locale, localePath, useTranslations, RAW, RELEASES } from '../i18n/ui';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);

type Style = { file: string; label: string; w: number; it: boolean };
const pair = (file: string, label: string, w: number): Style[] => [
  { file, label, w, it: false },
  { file: file === 'Regular' ? 'Italic' : `${file}Italic`, label: label === 'Regular' ? 'Italic' : `${label} Italic`, w, it: true },
];
const families = [
  {
    key: 'serif',
    title: t('dl.serif'),
    prefix: 'Balambika',
    font: 'var(--font-serif)',
    styles: [...pair('Regular', 'Regular', 400), ...pair('Medium', 'Medium', 500), ...pair('Bold', 'Bold', 700)],
  },
  {
    key: 'sans',
    title: t('dl.sans'),
    prefix: 'BalambikaSans',
    font: 'var(--font-sans)',
    styles: [
      ...pair('Light', 'Light', 300), ...pair('Regular', 'Regular', 400), ...pair('Medium', 'Medium', 500),
      ...pair('SemiBold', 'SemiBold', 600), ...pair('Bold', 'Bold', 700), ...pair('Black', 'Black', 900),
    ],
  },
];
---
<section class="section" id="download" aria-labelledby="dl-title">
  <div class="container">
    <header class="section-head reveal">
      <p class="eyebrow">{t('dl.eyebrow')}</p>
      <h2 id="dl-title">{t('dl.title')}</h2>
      <p>{t('dl.lede')}</p>
    </header>
    {families.map((f) => (
      <section class="family" aria-labelledby={`dl-${f.key}`}>
        <h3 id={`dl-${f.key}`} style={`font-family:${f.font}`}>{f.title}</h3>
        <ul class="styles" role="list">
          {f.styles.map((s) => (
            <li class="style">
              <span class="sample" style={`font-family:${f.font};font-weight:${s.w};font-style:${s.it ? 'italic' : 'normal'}`}>
                <span lang="sa">बा</span> <span lang="sa-Latn">Bā</span> <span lang="bg">Ба</span>
              </span>
              <a href={`${RAW}/${f.prefix}-${s.file}.ttf`} download>{t('dl.file', { style: s.label })}</a>
            </li>
          ))}
        </ul>
      </section>
    ))}
    <p class="more">
      <a class="btn btn--primary" href={RELEASES} rel="external">{t('dl.release')}</a>
      <a class="btn" href={localePath(locale, 'usage/')}>{t('dl.install')}</a>
    </p>
  </div>
</section>

<style>
  .family + .family { margin-top: var(--space-48); }
  .family h3 { font-size: 1.6rem; font-weight: 500; line-height: 1.15; margin-bottom: var(--space-16); }
  .styles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    border-top: 1px solid var(--rule);
    margin: 0;
  }
  .style {
    display: grid;
    gap: var(--space-8);
    padding: var(--space-24) var(--space-16);
    border-bottom: 1px solid var(--rule-soft);
  }
  .sample { font-size: 2.6rem; line-height: 1.5; }
  .style a { font: var(--type-small); }
  .more { display: flex; flex-wrap: wrap; gap: var(--space-12); margin-top: var(--space-32); }
</style>
