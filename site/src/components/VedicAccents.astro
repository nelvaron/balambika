---
import { gayatri } from '../data/texts';
import { type Locale, useTranslations } from '../i18n/ui';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
const marks = [
  { m: '◌॒', cp: 'U+0952', name: 'Devanagari Stress Sign Anudatta', role: t('vedic.anudatta') },
  { m: '◌॑', cp: 'U+0951', name: 'Devanagari Stress Sign Udatta', role: t('vedic.svarita') },
  { m: '—', cp: '—', name: 'Udātta', role: t('vedic.udatta') },
  { m: '◌᳚', cp: 'U+1CDA', name: 'Vedic Tone Double Svarita', role: t('vedic.double') },
  { m: 'ꣳ', cp: 'U+A8F3', name: 'Devanagari Sign Candrabindu Virama', role: t('vedic.cbv') },
];
// Sāmaveda marks, Devanagari Extended: combining digits U+A8E0–A8E9 and
// combining letters and signs U+A8EA–A8F1, each shown on a dotted circle.
const span = (a: number, b: number) => Array.from({ length: b - a + 1 }, (_, i) => a + i);
const samaGroups = [
  { label: t('vedic.sama.digits'), cps: span(0xa8e0, 0xa8e9) },
  { label: t('vedic.sama.letters'), cps: span(0xa8ea, 0xa8f1) },
];
const hex = (cp: number) => `U+${cp.toString(16).toUpperCase()}`;
---
<section class="section" id="vedic" aria-labelledby="vedic-title">
  <div class="container grid">
    <header class="section-head reveal">
      <p class="eyebrow">{t('vedic.eyebrow')}</p>
      <h2 id="vedic-title">{t('vedic.title')}</h2>
      <p>{t('vedic.lede')}</p>
    </header>

    <figure class="mantra card nv-ruled">
      <label class="switch">
        <input type="checkbox" role="switch" checked />
        <span>{t('vedic.toggle')}</span>
      </label>
      <div class="layers">
        <p class="accented" lang="sa">{gayatri.accented}</p>
        <p class="plain" lang="sa" aria-hidden="true">{gayatri.plain}</p>
      </div>
      <p class="iast" lang="sa-Latn">{gayatri.iast}</p>
      <p class="tr" lang={locale}>{locale === 'bg' ? gayatri.bg : gayatri.en}</p>
      <figcaption class="eyebrow">{t('vedic.source')}</figcaption>
    </figure>

    <div class="table-wrap">
      <table>
        <caption>{t('vedic.table')}</caption>
        <thead>
          <tr>
            <th scope="col">{t('vedic.mark')}</th>
            <th scope="col">{t('vedic.code')}</th>
            <th scope="col">{t('vedic.name')}</th>
            <th scope="col">{t('vedic.role')}</th>
          </tr>
        </thead>
        <tbody>
          {marks.map((m) => (
            <tr>
              <th scope="row" lang="sa" class="mark">{m.m}</th>
              <td><code>{m.cp}</code></td>
              <td>{m.name}</td>
              <td>{m.role}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <section class="sama card" aria-labelledby="sama-title">
      <h3 id="sama-title">{t('vedic.sama')}</h3>
      <p class="sama-lede">{t('vedic.sama.lede')}</p>
      <p class="sama-note only-serif">{t('vedic.sama.serif')}</p>
      {samaGroups.map((g) => (
        <figure class="sama-group">
          <figcaption class="eyebrow">{g.label}</figcaption>
          <ul role="list" class="sama-marks">
            {g.cps.map((cp) => (
              <li><span lang="sa" class="sama-g">◌{String.fromCodePoint(cp)}</span><code>{hex(cp)}</code></li>
            ))}
          </ul>
        </figure>
      ))}
    </section>
  </div>
</section>

<style>
  .grid { display: grid; gap: var(--space-32); }
  .mantra {
    display: grid;
    gap: var(--space-16);
    padding: clamp(var(--space-24), 4vw, var(--space-48));
  }
  .switch { display: inline-flex; align-items: center; gap: var(--space-12); min-height: 44px; cursor: pointer; justify-self: start; font: var(--type-small); color: var(--ink-2); }
  .switch input {
    appearance: none;
    width: 44px; height: 26px; margin: 0;
    border-radius: var(--radius-pill);
    border: 1px solid var(--control-border);
    background: var(--band);
    position: relative;
    cursor: pointer;
  }
  .switch input::after {
    content: ''; position: absolute; top: 3px; left: 3px;
    width: 18px; height: 18px; border-radius: 50%;
    background: var(--control-border);
    transition: translate 160ms;
  }
  .switch input:checked { background: var(--accent); border-color: var(--accent); }
  .switch input:checked::after { translate: 18px 0; background: var(--on-accent); }
  @media (prefers-reduced-motion: reduce) { .switch input::after { transition: none; } }

  .layers { display: grid; }
  .layers > p {
    grid-area: 1 / 1;
    white-space: pre-line;
    font: 400 clamp(1.9rem, 1rem + 3.4vw, 3.6rem) / 1.9 var(--font-text);
    color: var(--ink);
  }
  .plain { visibility: hidden; }
  .mantra:has(.switch input:not(:checked)) .accented { visibility: hidden; }
  .mantra:has(.switch input:not(:checked)) .plain { visibility: visible; }
  .iast { white-space: pre-line; font: italic 400 clamp(1.2rem, 1rem + 0.8vw, 1.6rem) / 1.5 var(--font-text); color: var(--ochre); }
  .tr { font: var(--type-lede); color: var(--ink-2); max-width: 40rem; }

  .table-wrap { overflow-x: auto; }

  .sama { display: grid; gap: var(--space-16); padding: clamp(var(--space-24), 4vw, var(--space-32)); }
  .sama h3 { font: var(--type-heading-2); }
  .sama-lede { font: var(--type-body); color: var(--ink-2); max-width: 46rem; }
  .sama-note { font: var(--type-small); color: var(--ochre-deep); background: var(--ochre-soft); padding: var(--space-8) var(--space-12); border-radius: var(--radius-sm); justify-self: start; }
  .sama-group { display: grid; gap: var(--space-8); margin: 0; }
  .sama-marks { display: grid; grid-template-columns: repeat(auto-fill, minmax(72px, 1fr)); margin: 0; border-top: 1px solid var(--rule-soft); border-inline-start: 1px solid var(--rule-soft); }
  .sama-marks li { display: grid; justify-items: center; padding: var(--space-8) var(--space-6); border-bottom: 1px solid var(--rule-soft); border-inline-end: 1px solid var(--rule-soft); background: var(--paper); }
  /* Always Balambika Sans: the serif family has no glyphs for these marks. */
  .sama-g { font: 400 2.2rem / 1.7 var(--font-sans); }
  .sama-marks code { font-size: 0.66rem; color: var(--ink-3); }
  .mark { font: 400 2rem / 1.6 var(--font-text); }
</style>
